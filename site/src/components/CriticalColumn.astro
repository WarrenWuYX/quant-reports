---
interface Props {
  title: string;
  color: string;
  border: string;
  items: string[];
}

const { title, color, border, items } = Astro.props;
---

<div class={`panel p-4 border-l-2 ${border}`}>
  <h3 class={`text-xs font-mono ${color} uppercase tracking-wider mb-2`}>{title}</h3>
  {items.length === 0 ? (
    <p class="text-xs text-gray-500">无</p>
  ) : (
    <ul class="list-disc list-inside space-y-1 text-sm text-gray-300">
      {items.map((item: string) => <li>{item}</li>)}
    </ul>
  )}
</div>