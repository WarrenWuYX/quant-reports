---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <div class="max-w-3xl mx-auto px-4 py-8">
    <h1 class="text-2xl font-bold mb-8 font-mono">
      <span class="text-accent-cyan">&gt;</span> 关于
    </h1>

    <div class="space-y-6 text-sm text-gray-300 leading-relaxed">
      <div class="panel p-5">
        <h2 class="text-lg font-semibold text-white mb-3">QuantReports</h2>
        <p>
          量化研报分析平台 — 自动化提取、分析、分类量化金融研报，
          构建可检索、可对比的研报知识库。
        </p>
      </div>

      <div class="panel p-5">
        <h2 class="text-lg font-semibold text-white mb-3">工作流</h2>
        <ol class="list-decimal list-inside space-y-2">
          <li><span class="text-accent-cyan">Ingest</span> — 解析 Markdown/PDF 研报，提取结构化文档</li>
          <li><span class="text-accent-cyan">Extract</span> — LLM 提取关键信息：分类、绩效、构造细节</li>
          <li><span class="text-accent-cyan">Analyze</span> — LLM 深度分析：经济逻辑、归因、稳健性、批判性评估</li>
          <li><span class="text-accent-cyan">Publish</span> — 静态网站生成，全量可检索</li>
        </ol>
      </div>

      <div class="panel p-5">
        <h2 class="text-lg font-semibold text-white mb-3">技术栈</h2>
        <div class="grid grid-cols-2 gap-3 text-xs font-mono">
          <div class="bg-bg rounded p-3">
            <span class="text-accent-cyan">Python</span>
            <p class="text-gray-500 mt-1">pydantic v2 · 流水线 · CLI</p>
          </div>
          <div class="bg-bg rounded p-3">
            <span class="text-accent-green">LLM</span>
            <p class="text-gray-500 mt-1">Volcengine Ark · 两阶段分析</p>
          </div>
          <div class="bg-bg rounded p-3">
            <span class="text-accent-amber">Astro</span>
            <p class="text-gray-500 mt-1">静态站点 · Tailwind CSS</p>
          </div>
          <div class="bg-bg rounded p-3">
            <span class="text-accent-indigo">Schema</span>
            <p class="text-gray-500 mt-1">Zod · JSON · 类型安全</p>
          </div>
        </div>
      </div>

      <div class="panel p-5">
        <h2 class="text-lg font-semibold text-white mb-3">Schema 版本</h2>
        <p class="font-mono text-accent-cyan">v1.0</p>
        <p class="text-gray-500 mt-1">分析 JSON 遵循统一 schema，支持跨报告对比检索。</p>
      </div>
    </div>
  </div>
</BaseLayout>